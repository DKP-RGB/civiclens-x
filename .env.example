# ---------------------------------------------------------------------------
# CivicLens X - environment template
# Copy to .env and fill in locally. Never commit .env
# ---------------------------------------------------------------------------

# App
APP_ENV=development
APP_NAME=CivicLens X
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Database (Phase 3). SQLite works with zero setup; PostGIS is recommended.
DATABASE_URL=sqlite:///./civiclens.db
# DATABASE_URL=postgresql+psycopg://civiclens:civiclens@localhost:5432/civiclens

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Gemini (free tier via Google AI Studio). Leave blank to run with fallback text.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Model artifacts (Phase 5)
MODEL_DIR=./artifacts
MODEL_VERSION=0.1.0-prototype

# Public data sources (no keys required for the free endpoints used)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
CACHE_DIR=../data/cache
