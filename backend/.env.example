# CivicLens X backend (Phase 4)
# Copy to .env and adjust locally. Never commit .env.

APP_ENV=development
APP_NAME=CivicLens X
LOG_LEVEL=INFO

# SQLite works with zero setup. Point this at PostGIS/PostgreSQL for production.
DATABASE_URL=sqlite:///./civiclens.db
# DATABASE_URL=postgresql+psycopg://civiclens:civiclens@localhost:5432/civiclens

# Uploads for citizen photos
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Phase 6: Gemini explanations (blank = rule-based fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Phase 5: trained model artifacts
MODEL_DIR=./artifacts
MODEL_VERSION=0.1.0-prototype

# Phase 4: keyless public data ingestion (Open-Meteo + Overpass)
CITY_NAME=Indore
CITY_LAT=22.7196
CITY_LNG=75.8577
CITY_TIMEZONE=Asia/Kolkata
CITY_BBOX=22.58,75.70,22.87,76.02
INGESTION_TIMEOUT_SECONDS=120
FORECAST_STALE_HOURS=12
USER_AGENT=CivicLensX/0.4 (research prototype; Indore urban intelligence)
